# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/fastget

# Secret for signing session cookies (HMAC-SHA-256). REQUIRED.
# Generate a strong random value, e.g.:  openssl rand -hex 32
ADMIN_SESSION_SECRET=

# Next.js Environment
NODE_ENV=development

# Optional: Google Sheets API key for live catalogue fetch (npm run import-sheet)
# Without this key, the embedded catalogue array in scripts/data/catalogue.ts is used.
# GOOGLE_SHEETS_API_KEY=your_key_here

# Optional: set to 1 to preview import without writing to the database
# DRY_RUN=1

# Razorpay Payment Gateway
# Get these from https://dashboard.razorpay.com/app/keys
# Use Test keys (rzp_test_*) during development; switch to Live keys in production.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# NEXT_PUBLIC_ prefix makes the key available in the browser (safe - this is the public key only)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxxxxxx

# Secret shown once when creating the webhook in Dashboard → Settings → Webhooks.
# NOT the same value as RAZORPAY_KEY_SECRET. Required for /api/webhooks/razorpay
# to accept events - without it, that endpoint returns 500 to every request.
RAZORPAY_WEBHOOK_SECRET=

# Production domain (used to build links in transactional emails)
APP_URL=https://fastget.in
NEXT_PUBLIC_APP_URL=https://fastget.in
EMAIL_FROM=FastGet <noreply@fastget.in>
EMAIL_PROVIDER=resend
RESEND_API_KEY=

# PostHog product analytics (funnels, retention, session replay). Leave the key
# empty and analytics is off. Setup steps: docs/ANALYTICS_SETUP.md.
# Project API key (phc_...) from PostHog → Project settings - public, safe in the browser.
NEXT_PUBLIC_POSTHOG_KEY=
# "us" or "eu" - whichever cloud the PostHog account was created in.
NEXT_PUBLIC_POSTHOG_REGION=us

# Phone-number login via WhatsApp OTP - OFF until the WhatsApp number is set up.
# Full setup steps: docs/PHONE_LOGIN_SETUP.md. Leave the flag unset/false and
# login stays email + password only.
NEXT_PUBLIC_PHONE_LOGIN_ENABLED=false
# From Meta → WhatsApp Manager / developers.facebook.com → your app → WhatsApp → API Setup
WHATSAPP_PHONE_NUMBER_ID=
# Permanent System User token (not the 24-hour temporary one) - see the guide
WHATSAPP_ACCESS_TOKEN=
# Name + language of the approved Authentication template
WHATSAPP_OTP_TEMPLATE=fastget_login_code
WHATSAPP_TEMPLATE_LANG=en
# Optional - only used by `npm run check-phone-login` to confirm the template is approved
WHATSAPP_BUSINESS_ACCOUNT_ID=

# New-order staff alerts (src/lib/order-notifications.ts)
# Bot token from @BotFather (Telegram) - required for real delivery; without it,
# Telegram sends are logged only (mock mode). Each admin/agent links their own
# chat ID under My Profile → Telegram order alerts (get it from @userinfobot).
TELEGRAM_BOT_TOKEN=
